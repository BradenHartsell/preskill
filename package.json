{
  "name": "@vxbe/preskill",
  "version": "0.2.0",
  "description": "Check what an AI agent Skill would make your assistant do before you install it.",
  "license": "MIT",
  "author": "VXBE",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BradenHartsell/preskill.git"
  },
  "homepage": "https://github.com/BradenHartsell/preskill#readme",
  "bugs": {
    "url": "https://github.com/BradenHartsell/preskill/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "agent-skills",
    "security",
    "scanner"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "preskill": "./dist/cli.js"
  },
  "files": [
    "dist",
    "agent",
    "README.md",
    "PORTING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run typecheck:core && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test": "tsx --test test/*.test.ts",
    "bench": "tsx bench/run.ts",
    "bench:fetch": "tsx bench/fetch.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
